{
  "name": "battler",
  "version": "0.1.0",
  "description": "Make your AI subscriptions (Claude, ChatGPT, Grok) debate each other, then judge each other blind. No API keys.",
  "author": "derekimp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/derekimp/battler.git"
  },
  "homepage": "https://github.com/derekimp/battler#readme",
  "bugs": {
    "url": "https://github.com/derekimp/battler/issues"
  },
  "type": "module",
  "bin": {
    "battler": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && chmod +x dist/cli.js",
    "prepare": "npm run build",
    "dev": "node src/cli.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test test/*.test.ts",
    "test:dist": "npm run build && BATTLER_ENTRY=dist/cli.js node --test test/cli.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ai",
    "llm",
    "debate",
    "claude",
    "chatgpt",
    "codex",
    "grok",
    "cursor",
    "cli"
  ],
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
