{
  "name": "battler",
  "version": "0.2.0",
  "description": "Make your AI subscriptions (Claude, ChatGPT, Grok) debate each other, then judge each other blind. No API keys.",
  "author": "derekimp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/derekimp/battler.git"
  },
  "homepage": "https://derekimp.github.io/battler/",
  "bugs": {
    "url": "https://github.com/derekimp/battler/issues"
  },
  "type": "module",
  "bin": {
    "battler": "dist/bin.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && chmod +x dist/bin.js dist/cli.js",
    "prepare": "npm run build",
    "dev": "node src/cli.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test test/*.test.ts",
    "test:dist": "npm run build && BATTLER_ENTRY=dist/cli.js node --test test/cli.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "build:extension": "npm run build && node scripts/build-extension.mjs",
    "test:extension": "npm run build:extension && node --test test/extension-bundle.check.ts",
    "test:web": "node --test test/web-ui.check.ts",
    "test:live": "node scripts/live-check.mjs"
  },
  "license": "MIT",
  "files": [
    "dist",
    "web",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ai",
    "llm",
    "debate",
    "claude",
    "chatgpt",
    "codex",
    "grok",
    "cursor",
    "cli"
  ],
  "devDependencies": {
    "@types/node": "^26.6.3",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2"
  }
}
